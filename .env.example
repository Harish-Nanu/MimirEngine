# Copy to .env to override defaults. Every setting is in mimir/config.py.

# Embeddings: local (default, no key) | openai | voyage
MIMIR_EMBEDDING_PROVIDER=local
# MIMIR_EMBEDDING_MODEL=
# MIMIR_EMBEDDING_API_KEY=
# Client-side cap per worker, requests/second (0 = unlimited)
MIMIR_EMBEDDING_MAX_RPS=0

# Changing provider/model changes vector size: use a new collection name.
MIMIR_QDRANT_COLLECTION=mimir_chunks

MIMIR_MAX_ATTEMPTS=5
MIMIR_CHUNK_SIZE=1000
MIMIR_CHUNK_OVERLAP=150
